    out property <string> trash: "M4 7h16M10 11v6M14 11v6M6 7l1 13h10l1-13M9 7V4h6v3";
    out property <string> arrow-right: "M5 12h14M13 6l6 6-6 6";
    out property <string> lock: "M6 11h12a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1v-8a1 1 0 0 1 1-1zM8 11V8a4 4 0 0 1 8 0v3";
    out property <string> power: "M12 3v9M6.3 7.3a8 8 0 1 0 11.4 0";
