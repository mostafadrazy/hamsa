    out property <string> x: "M18 6 6 18M6 6l12 12";
    out property <string> check: "M5 12l5 5L20 7";
    out property <string> download: "M12 3v12m0 0-4-4m4 4 4-4M4 19h16";
    out property <string> paste: "M8 3h8v4H8zM8 5H6a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2";
    out property <string> lines: "M4 6h16M4 12h10M4 18h7";
