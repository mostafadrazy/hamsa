// Shared building blocks, matched to the web version's styles (hub.css / theme.css) at 1 px = 1 CSS px.
import { Theme } from "theme.slint";

// A 24 × 24 stroke icon (same as Icon.tsx: round caps and joins, 1.8 px stroke by default).
export component Icon inherits Path {
    in property <string> path;
    in property <color> color: Theme.text;
    in property <length> size: 18px;
    in property <length> stroke-px: 1.8px;
    width: size;
    height: size;
    commands: path;
    viewbox-width: 24;
    viewbox-height: 24;
    stroke: color;
    // Slint's software renderer smooths thin strokes about 0.4 px heavier than a browser; 80% matches Icon.tsx by eye.
    stroke-width: stroke-px * 0.8;
    stroke-line-cap: round;
    stroke-line-join: round;
    fill: transparent;
}

// Four whole-pixel panes: at keycap sizes a Path loses its sub-pixel gaps and draws one solid square.
export component WinLogo inherits Rectangle {
    in property <length> size: 16px;
    in property <color> fill: #000000;
    property <length> gap: max(1px, round(size / 24px) * 1px);
    property <length> pane: round((size * 18 / 24 - gap) / 2px) * 1px;
    width: size;
    height: size;
    property <length> o: round((size - 2 * pane - gap) / 2px) * 1px;
    Rectangle { x: o; y: o; width: pane; height: pane; background: root.fill; }
    Rectangle { x: o + pane + gap; y: o; width: pane; height: pane; background: root.fill; }
    Rectangle { x: o; y: o + pane + gap; width: pane; height: pane; background: root.fill; }
    Rectangle { x: o + pane + gap; y: o + pane + gap; width: pane; height: pane; background: root.fill; }
}

// One keycap: white face, black outline, solid shadow underneath; the label sits bottom-left (theme.css .key).
component Key inherits Rectangle {
    in property <string> label;
    in property <int> size; // 0 = small, 1 = medium, 2 = large
    // On the black (light theme) bar pill the keys get a white outline and a grey shadow (.pill-hint .key).
    in property <color> edge: #000000;
    in property <color> shadow-color: #000000;
    in property <color> face: #ffffff;
    property <bool> win: label == "Win";
    property <length> shadow: size == 2 ? 6px : size == 1 ? 4px : 3px;
    property <length> h: size == 2 ? 80px : size == 1 ? 40px : 26px;
    property <length> pad-x: size == 2 ? 14px : size == 1 ? 10px : 7px;
    property <length> pad-b: size == 2 ? 10px : size == 1 ? 5px : 3px;
    property <length> icon-w: size == 2 ? 92px : size == 1 ? 48px : 28px;
    property <length> min-w: size == 2 ? 92px : size == 1 ? 52px : 0px;
    // Like CSS box-shadow, the shadow is drawn below the key without taking up layout space.
    height: h;
    width: win ? icon-w : max(min-w, t.preferred-width + 2 * pad-x);
    Rectangle {
        y: root.shadow;
        height: root.h;
        border-radius: size == 2 ? 16px : size == 1 ? 10px : 7px;
        background: root.shadow-color;
    }
    Rectangle {
        y: 0;
        height: root.h;
        border-radius: size == 2 ? 16px : size == 1 ? 10px : 7px;
        background: root.face;
        border-color: root.edge;
        border-width: size == 2 ? 2px : 1.5px;
        if root.win: WinLogo {
            size: size == 2 ? 26px : size == 1 ? 16px : 11px;
        }
        t := Text {
            visible: !root.win;
            x: root.pad-x;
            y: parent.height - self.height - root.pad-b;
            text: root.label;
            color: #000000;
            font-weight: Theme.key-weight;
            font-size: size == 2 ? 20px : size == 1 ? 14px : 11.5px;
        }
    }
}

export component Keycaps inherits HorizontalLayout {
    in property <[string]> labels: ["Ctrl", "Win"];
    in property <int> size: 2;
    in property <color> plus-color: #000000;
    in property <color> edge: #000000;
    in property <color> shadow-color: #000000;
    in property <color> face: #ffffff;
    // Canvas: 14 px between the big hero keys, 10 px in Settings, 4 px on the bar.
    spacing: size == 2 ? 14px : size == 1 ? 10px : 4px;
    alignment: start;
    for label[i] in labels: HorizontalLayout {
        spacing: root.spacing;
        if i > 0 && root.size > 0: Text {
            text: "+";
            vertical-alignment: center;
            font-weight: Theme.key-weight;
            font-size: root.size == 2 ? 22px : 15px;
            color: root.plus-color;
        }
        Key {
            label: label;
            size: root.size;
            edge: root.edge;
            shadow-color: root.shadow-color;
            face: root.face;
        }
    }
}

// .btn .btn-solid
export component SolidButton inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> enabled: true;
    in property <length> pad: 18px;
    in property <bool> icon-after: false; // the icon follows the text instead of leading it
    callback clicked();
    height: 40px;
    width: l.preferred-width;
    border-radius: self.height / 2;
    background: ta.has-hover && enabled ? Theme.accent-hover : Theme.accent;
    opacity: enabled ? 1 : 0.55;
    l := HorizontalLayout {
        padding-left: root.pad;
        padding-right: root.pad;
        spacing: 8px;
        alignment: center;
        if root.icon != "" && !root.icon-after: Icon {
            path: root.icon;
            color: Theme.on-accent;
            size: 16px;
            stroke-px: 2px;
            y: (parent.height - self.height) / 2;
        }
        Text {
            text: root.text;
            color: Theme.on-accent;
            font-size: 14px;
            font-weight: 600;
            vertical-alignment: center;
        }
        if root.icon != "" && root.icon-after: Icon {
            path: root.icon;
            color: Theme.on-accent;
            size: 16px;
            stroke-px: 2px;
            y: (parent.height - self.height) / 2;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : not-allowed;
        clicked => { root.clicked(); }
    }
}

// .btn .btn-line
export component LineButton inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> enabled: true;
    in property <color> tint: Theme.text;
    in property <color> edge: Theme.input-line;
    callback clicked();
    height: 40px;
    width: l.preferred-width;
    border-radius: self.height / 2;
    border-width: 1px;
    border-color: root.edge;
    background: ta.has-hover && enabled ? Theme.line-hover : Theme.line-bg;
    opacity: enabled ? 1 : 0.55;
    l := HorizontalLayout {
        padding-left: 18px;
        padding-right: 18px;
        spacing: 8px;
        alignment: center;
        if root.icon != "": Icon {
            path: root.icon;
            color: root.tint;
            size: 16px;
            stroke-px: 2px;
            y: (parent.height - self.height) / 2;
        }
        Text {
            text: root.text;
            color: root.tint;
            font-size: 14px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// .icon-btn
export component IconButton inherits Rectangle {
    in property <string> icon;
    in property <string> label; // what a screen reader says
    in property <length> icon-size: 16px;
    out property <bool> hovered: ta.has-hover;
    callback clicked();
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: ta.has-hover ? Theme.hover : transparent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    Icon {
        path: root.icon;
        size: root.icon-size;
        color: ta.has-hover ? Theme.text : Theme.muted;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// .seg-group: pick one of several, inside a rounded tray.
export component Seg inherits Rectangle {
    in property <[string]> options;
    in-out property <int> selected;
    in property <length> pad: 16px;
    callback picked(int);
    height: 46px;
    width: l.preferred-width;
    border-radius: 23px;
    background: Theme.seg;
    border-width: 1px;
    border-color: Theme.line;
    l := HorizontalLayout {
        padding: 4px;
        spacing: 4px;
        for o[i] in root.options: Rectangle {
            border-radius: 18px;
            background: i == root.selected ? Theme.accent : transparent;
            width: st.preferred-width + 2 * root.pad;
            st := Text {
                text: o;
                font-size: 14px;
                font-weight: 500;
                color: i == root.selected ? Theme.on-accent : Theme.nav;
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.selected = i;
                    root.picked(i);
                }
            }
        }
    }
}

// .tabs / .tab: plain pills, no tray.
export component Tabs inherits HorizontalLayout {
    in property <[string]> options;
    in-out property <int> selected;
    spacing: 4px;
    alignment: start;
    for o[i] in root.options: Rectangle {
        height: 36px;
        width: tt.preferred-width + 28px;
        border-radius: 18px;
        background: i == root.selected ? Theme.accent : ta.has-hover ? Theme.hover : transparent;
        tt := Text {
            text: o;
            font-size: 14px;
            font-weight: 500;
            color: i == root.selected ? Theme.on-accent : ta.has-hover ? Theme.text : Theme.nav;
        }
        ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.selected = i; }
        }
    }
}

export component Switch inherits Rectangle {
    in-out property <bool> on;
    callback toggled(bool);
    width: 52px;
    height: 32px;
    border-radius: 16px;
    background: on ? Theme.switch-on : Theme.track-off;
    Rectangle {
        width: 26px;
        height: 26px;
        y: 3px;
        x: root.on ? 23px : 3px;
        border-radius: 13px;
        background: root.on ? Theme.switch-on-knob : Theme.switch-off-knob;
        animate x { duration: 150ms; easing: ease-out; }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.on = !root.on;
            root.toggled(root.on);
        }
    }
}

// .chip
export component Chip inherits Rectangle {
    in property <string> text;
    height: 32px;
    width: ct.preferred-width + 26px;
    border-radius: 16px;
    background: Theme.chip;
    border-width: 1px;
    border-color: Theme.line;
    ct := Text {
        text: root.text;
        font-size: 13px;
        font-weight: 500;
        color: Theme.text;
    }
}

// .tag
export component Tag inherits Rectangle {
    in property <string> text;
    in property <int> kind; // 0 soft, 1 accent, 2 teal
    height: 21px;
    width: tt.preferred-width + 18px;
    border-radius: 11px;
    background: kind == 1 ? Theme.accent : kind == 2 ? Theme.teal-bg : Theme.tag-soft;
    tt := Text {
        text: root.text;
        font-size: 12px;
        font-weight: 600;
        color: kind == 1 ? Theme.on-accent : kind == 2 ? Theme.teal : Theme.tag-soft-text;
    }
}

// .field: a label over a single-line .input.
export component Field inherits VerticalLayout {
    in property <string> label;
    in property <string> placeholder;
    in property <string> note; // lighter text after the label, e.g. "(optional)"
    in-out property <string> text;
    callback accepted();
    spacing: 6px;
    HorizontalLayout {
        spacing: 4px;
        alignment: start;
        Text {
            text: root.label;
            font-size: 13px;
            font-weight: 600;
            color: Theme.text;
        }
        if root.note != "": Text {
            text: root.note;
            font-size: 13px;
            color: Theme.muted;
        }
    }
    Rectangle {
        height: 44px;
        border-radius: 12px;
        border-width: 1px;
        border-color: Theme.input-line;
        background: Theme.card;
        // :focus-visible outline
        Rectangle {
            visible: ti.has-focus;
            x: -3px;
            y: -3px;
            width: parent.width + 6px;
            height: parent.height + 6px;
            border-radius: 15px;
            border-width: 2px;
            border-color: Theme.accent;
        }
        Text {
            x: 14px;
            text: root.placeholder;
            visible: root.text == "";
            color: #8a8578;
            font-size: 15px;
        }
        ti := TextInput {
            x: 14px;
            width: parent.width - 28px;
            text <=> root.text;
            color: Theme.text;
            font-size: 15px;
            single-line: true;
            vertical-alignment: center;
            selection-background-color: Theme.accent.with-alpha(0.25);
            accepted => { root.accepted(); }
        }
    }
}

// A label over a multi-line .input.textarea.
export component Area inherits VerticalLayout {
    in property <length> box-height: 116px;
    in property <string> label;
    in property <string> placeholder;
    in-out property <string> text;
    spacing: 6px;
    Text {
        text: root.label;
        font-size: 13px;
        font-weight: 600;
        color: Theme.text;
    }
    // rows=4 textarea: 104 px minimum, 116 px with four lines at 1.5 line height
    Rectangle {
        height: root.box-height;
        border-radius: 12px;
        border-width: 1px;
        border-color: Theme.input-line;
        background: Theme.card;
        Rectangle {
            visible: ti.has-focus;
            x: -3px;
            y: -3px;
            width: parent.width + 6px;
            height: parent.height + 6px;
            border-radius: 15px;
            border-width: 2px;
            border-color: Theme.accent;
        }
        Text {
            x: 14px;
            y: 12px;
            text: root.placeholder;
            visible: root.text == "";
            color: #8a8578;
            font-size: 15px;
        }
        ti := TextInput {
            x: 14px;
            y: 12px;
            width: parent.width - 28px;
            height: parent.height - 24px;
            text <=> root.text;
            color: Theme.text;
            font-size: 15px;
            single-line: false;
            wrap: word-wrap;
            selection-background-color: Theme.accent.with-alpha(0.25);
        }
    }
}

// .input.select: pick from a list (opens a popup).
export component Select inherits Rectangle {
    in property <[string]> options;
    in-out property <int> selected;
    in property <bool> enabled: true;
    callback picked(int);
    height: 40px;
    width: max(200px, label.preferred-width + 50px);
    border-radius: 10px;
    border-width: 1px;
    border-color: Theme.input-line;
    background: Theme.card;
    opacity: enabled ? 1 : 0.5;
    label := Text {
        x: 12px;
        text: root.selected >= 0 && root.selected < root.options.length ? root.options[root.selected] : "";
        color: Theme.text;
        font-size: 14px;
    }
    Icon {
        x: parent.width - 26px;
        path: "M6 9l6 6 6-6";
        size: 16px;
        stroke-px: 2px;
        color: Theme.text;
    }
    TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { popup.show(); }
    }
    popup := PopupWindow {
        x: 0;
        y: root.height + 4px;
        width: root.width;
        Rectangle {
            background: Theme.card;
            border-radius: 12px;
            border-width: 1px;
            border-color: Theme.line;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000040;
            Flickable {
                height: min(root.options.length * 36px + 12px, 320px);
                content-height: root.options.length * 36px + 12px;
                VerticalLayout {
                    padding: 6px;
                    for o[i] in root.options: Rectangle {
                        height: 36px;
                        border-radius: 8px;
                        background: oa.has-hover ? Theme.hover : i == root.selected ? Theme.active : transparent;
                        Text {
                            x: 10px;
                            text: o;
                            color: Theme.text;
                            font-size: 14px;
                            width: parent.width - 20px;
                            overflow: elide;
                        }
                        oa := TouchArea {
                            clicked => {
                                root.selected = i;
                                root.picked(i);
                            }
                        }
                    }
                }
            }
        }
    }
}

// .panel
export component Panel inherits Rectangle {
    border-radius: 18px;
    background: Theme.panel-bg;
    border-width: 1px;
    border-color: Theme.line;
    clip: true;
}

// .panel-title (padding 20 24 8 is set where it's used)
export component PanelTitle inherits Text {
    font-size: Theme.panel-title-size;
    font-weight: 500;
    letter-spacing: Theme.panel-title-spacing;
    color: Theme.text;
}

// .setting-row: text on the left, control on the right; 16 px × 24 px padding.
export component SettingRow inherits HorizontalLayout {
    in property <string> title;
    in property <string> detail;
    in property <color> detail-color: Theme.muted;
    spacing: 16px;
    padding-top: 16px;
    padding-bottom: 16px;
    padding-left: 24px;
    padding-right: 24px;
    VerticalLayout {
        alignment: center;
        spacing: 4px;
        horizontal-stretch: 1;
        Text {
            text: root.title;
            font-size: 15px;
            font-weight: 600;
            color: Theme.text;
        }
        if root.detail != "": Text {
            text: root.detail;
            font-size: 13px;
            color: root.detail-color;
            wrap: word-wrap;
        }
    }
    @children
}

export component Divider inherits Rectangle {
    height: 1px;
    background: Theme.line;
}

// .empty: dashed outline, centred title and text.
export component EmptyState inherits Rectangle {
    in property <string> title;
    in property <string> body;
    height: el.preferred-height;
    Path {
        property <float> w: root.width / 1px - 1;
        property <float> h: root.height / 1px - 1;
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        viewbox-width: root.width / 1px;
        viewbox-height: root.height / 1px;
        commands: "M 16.5 0.5 L " + (w - 15.5) + " 0.5 A 16 16 0 0 1 " + (w + 0.5) + " 16.5 L " + (w + 0.5) + " " + (h - 15.5)
            + " A 16 16 0 0 1 " + (w - 15.5) + " " + (h + 0.5) + " L 16.5 " + (h + 0.5) + " A 16 16 0 0 1 0.5 " + (h - 15.5)
            + " L 0.5 16.5 A 16 16 0 0 1 16.5 0.5 Z";
        stroke: Theme.line;
        stroke-width: 1px;
        stroke-dash-array: [3px, 3px];
        fill: transparent;
    }
    el := VerticalLayout {
        padding-top: 36px;
        padding-bottom: 36px;
        padding-left: 24px;
        padding-right: 24px;
        spacing: 4px;
        Text { text: root.title; font-size: 16px; font-weight: 600; line-height-factor: 1.28; color: Theme.text; horizontal-alignment: center; }
        Text { text: root.body; font-size: 14px; line-height-factor: 1.28; color: Theme.muted; horizontal-alignment: center; wrap: word-wrap; }
    }
}

// A search box: magnifier, then a single-line input.
export component SearchBox inherits Rectangle {
    in property <string> placeholder: "Search";
    in-out property <string> text;
    callback edited(string);
    height: 44px;
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.input-line;
    background: Theme.card;
    Rectangle {
        visible: ti.has-focus;
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        border-radius: 15px;
        border-width: 2px;
        border-color: Theme.accent;
    }
    Icon {
        x: 14px;
        y: (parent.height - self.height) / 2;
        path: "M11 4a7 7 0 1 0 0 14 7 7 0 0 0 0-14zM20 20l-3.5-3.5";
        size: 16px;
        color: Theme.muted;
    }
    Text {
        x: 38px;
        text: root.placeholder;
        visible: root.text == "";
        color: #8a8578;
        font-size: 15px;
        vertical-alignment: center;
        height: parent.height;
    }
    ti := TextInput {
        x: 38px;
        width: parent.width - 52px;
        text <=> root.text;
        color: Theme.text;
        font-size: 15px;
        single-line: true;
        vertical-alignment: center;
        accessible-label: root.placeholder;
        selection-background-color: Theme.accent.with-alpha(0.25);
        edited => { root.edited(self.text); }
    }
}

// .seg-group with a count after each label.
export component CountSeg inherits Rectangle {
    in property <[string]> options;
    in property <[int]> counts;
    in-out property <int> selected;
    callback picked(int);
    height: 46px;
    width: l.preferred-width;
    border-radius: 23px;
    background: Theme.seg;
    border-width: 1px;
    border-color: Theme.line;
    l := HorizontalLayout {
        padding: 4px;
        spacing: 4px;
        for o[i] in root.options: Rectangle {
            border-radius: 18px;
            background: i == root.selected ? Theme.accent : transparent;
            width: row.preferred-width;
            row := HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 8px;
                alignment: center;
                Text {
                    text: o;
                    font-size: 14px;
                    font-weight: 500;
                    color: i == root.selected ? Theme.on-accent : Theme.nav;
                    vertical-alignment: center;
                }
                Text {
                    text: "\{root.counts[i]}";
                    font-size: 12px;
                    font-weight: 600;
                    color: i == root.selected ? Theme.on-accent : Theme.muted;
                    opacity: i == root.selected ? 0.75 : 1;
                    vertical-alignment: center;
                }
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.selected = i;
                    root.picked(i);
                }
            }
        }
    }
}
