// Hamsa design tokens: light and OLED dark, from the design canvas.
import "../assets/fonts/ReadexPro-Latin.ttf";
import "../assets/fonts/ReadexPro-LatinExt.ttf";
import "../assets/fonts/ReadexPro-Arabic.ttf";

export global Theme {
    in-out property <bool> dark: false;

    out property <color> bg: dark ? #000000 : #ffffff;
    out property <color> side: dark ? #0b0b0a : #f7f6f2;
    out property <color> side-line: dark ? #1d1c1a : #ebe9e3;
    out property <color> line: dark ? #1f1e1b : #e9e7e0;
    out property <color> text: dark ? #f5f4f0 : #0b0b0a;
    out property <color> muted: dark ? #a39d8e : #6b675d;
    out property <color> nav: dark ? #c5c0b3 : #4d4a42;
    out property <color> hover: dark ? #1a1917 : #eeece6;
    out property <color> active: dark ? #1f1e1b : #e9e7e0;
    out property <color> card: dark ? #0e0e0d : #ffffff;
    out property <color> chip: dark ? #0e0e0d : #f7f6f2;
    out property <color> row-hover: dark ? #0e0e0d : #faf9f6;
    out property <color> seg: dark ? #0e0e0d : #f4f3ef;
    out property <color> input-line: dark ? #4d4a42 : #c8c5bc;
    out property <color> track-off: dark ? #3a3833 : #d6d3cb;
    out property <color> accent: dark ? #f5f4f0 : #000000;
    out property <color> on-accent: dark ? #000000 : #ffffff;
    out property <color> accent-hover: dark ? #ffffff : #2a2a28;
    out property <color> ok: dark ? #34d399 : #18a558;
    out property <color> teal-bg: dark ? #072a25 : #d1f2ee;
    out property <color> teal: dark ? #8de3d6 : #034f46;
    out property <color> hero: dark ? #ffffff : #f2f1ec;
    out property <color> tag-soft: dark ? #1f1e1b : #f0eee8;
    out property <color> tag-soft-text: dark ? #c5c0b3 : #4d4a42;
    out property <color> danger: #d93f2b;
    // Dictation bar
    out property <color> pill: dark ? #f5f4f0 : #000000;
    out property <color> pill-fg: dark ? #000000 : #ffffff;
    out property <color> pill-soft: dark ? #deddd7 : #343432;

    out property <string> font: "Readex Pro";

    // Where the canvas boards (Warm · OLED / Hamsa · Light) style the two themes differently.
    out property <length> title-spacing: dark ? -0.66px : -0.88px; // -0.015em / -0.02em at 44 px
    out property <length> hero-size: dark ? 34px : 32px;
    out property <float> hero-line: dark ? 0.88 : 0.92; // CSS 1.1 / 1.15 ÷ the font's natural 1.25
    out property <length> hero-spacing: dark ? 0px : -0.48px;
    out property <int> key-weight: dark ? 800 : 700;
    // Medium keycaps in Settings: a light face on OLED, the white-and-black key on Light.
    out property <color> key-face: dark ? #f5f4f0 : #ffffff;
    out property <color> key-edge: dark ? #f5f4f0 : #000000;
    out property <color> key-shadow: dark ? #8a8578 : #000000;
    out property <bool> link-underline: !dark;
    out property <color> panel-bg: dark ? #0b0b0a : #ffffff;
    out property <length> panel-title-size: dark ? 24px : 22px;
    out property <length> panel-title-spacing: dark ? 0px : -0.22px;
    out property <length> h2-size: dark ? 28px : 26px;
    out property <length> h2-spacing: dark ? 0px : -0.39px;
    out property <color> line-bg: dark ? transparent : #ffffff;
    out property <color> line-hover: dark ? #1a1917 : #f4f3ef;
    out property <color> switch-on: dark ? #ffffff : #000000;
    out property <color> switch-on-knob: dark ? #000000 : #ffffff;
    out property <color> switch-off-knob: dark ? #c5c0b3 : #ffffff;
    out property <bool> pill-shadow: !dark;
}

